        "/^cat <<'NODE' \\| node\nconst fs = require\\('fs'\\);\nconst path = require\\('path'\\);\n\nconst root = 'src/app';\nconst files = \\[\n  'app\\.component\\.ts',\n  'components/button/button\\.component\\.ts',\n  'components/feature-card/feature-card\\.component\\.ts',\n  'components/gift-card/gift-card\\.component\\.ts',\n  'components/gift-details-modal/gift-details-modal\\.component\\.ts',\n  'components/guest-view/guest-view\\.component\\.ts',\n  'components/landing-page/landing-page\\.component\\.ts',\n  'components/testimonial/testimonial\\.component\\.ts'\n\\];\n\nfunction normalizeBlockContent\\(content\\) \\{\n  const normalized = content\\.replace\\(/\\\\r\\\\n/g, '\\\\n'\\);\n  const lines = normalized\\.split\\('\\\\n'\\);\n  if \\(lines\\.length > 0 && lines\\[0\\]\\.trim\\(\\) === ''\\) lines\\.shift\\(\\);\n  if \\(lines\\.length > 0 && lines\\[lines\\.length - 1\\]\\.trim\\(\\) === ''\\) lines\\.pop\\(\\);\n  const nonEmpty = lines\\.filter\\(\\(line\\) => line\\.trim\\(\\)\\.length > 0\\);\n  const minIndent = nonEmpty\\.length\n    \\? Math\\.min\\(\\.\\.\\.nonEmpty\\.map\\(\\(line\\) => line\\.match\\(/\\^\\\\s\\*/\\)\\[0\\]\\.length\\)\\)\n    : 0;\n  return lines\\.map\\(\\(line\\) => line\\.slice\\(minIndent\\)\\)\\.join\\('\\\\n'\\) \\+ '\\\\n';\n\\}\n\nfor \\(const rel of files\\) \\{\n  const tsPath = path\\.join\\(root, rel\\);\n  const absTsPath = path\\.resolve\\(tsPath\\);\n  const original = fs\\.readFileSync\\(absTsPath, 'utf8'\\);\n  let text = original;\n\n  const baseName = path\\.basename\\(tsPath, '\\.ts'\\);\n  const dir = path\\.dirname\\(absTsPath\\);\n  const htmlName = `\\$\\{baseName\\}\\.html`;\n  const scssName = `\\$\\{baseName\\}\\.scss`;\n\n  const templateStylesRegex = /template:\\\\s\\*`\\(\\[\\\\s\\\\S\\]\\*\\?\\)`,\\\\s\\*styles:\\\\s\\*\\\\\\[\\\\s\\*`\\(\\[\\\\s\\\\S\\]\\*\\?\\)`\\\\s\\*\\\\\\]/m;\n  const templateOnlyRegex = /template:\\\\s\\*`\\(\\[\\\\s\\\\S\\]\\*\\?\\)`/m;\n\n  if \\(templateStylesRegex\\.test\\(original\\)\\) \\{\n    const match = original\\.match\\(templateStylesRegex\\);\n    if \\(!match\\) throw new Error\\(`Could not capture template/styles for \\$\\{tsPath\\}`\\);\n\n    text = text\\.replace\\(templateStylesRegex, `templateUrl: '\\./\\$\\{htmlName\\}',\\\\n  styleUrl: '\\./\\$\\{scssName\\}'`\\);\n\n    const html = normalizeBlockContent\\(match\\[1\\]\\);\n    const scss = normalizeBlockContent\\(match\\[2\\]\\);\n    fs\\.writeFileSync\\(path\\.join\\(dir, htmlName\\), html, 'utf8'\\);\n    fs\\.writeFileSync\\(path\\.join\\(dir, scssName\\), scss, 'utf8'\\);\n  \\} else if \\(templateOnlyRegex\\.test\\(original\\)\\) \\{\n    const match = original\\.match\\(templateOnlyRegex\\);\n    if \\(!match\\) throw new Error\\(`Could not capture template for \\$\\{tsPath\\}`\\);\n\n    text = text\\.replace\\(templateOnlyRegex, `templateUrl: '\\./\\$\\{htmlName\\}',\\\\n  styleUrl: '\\./\\$\\{scssName\\}'`\\);\n\n    const html = normalizeBlockContent\\(match\\[1\\]\\);\n    fs\\.writeFileSync\\(path\\.join\\(dir, htmlName\\), html, 'utf8'\\);\n    if \\(!fs\\.existsSync\\(path\\.join\\(dir, scssName\\)\\)\\) \\{\n      fs\\.writeFileSync\\(path\\.join\\(dir, scssName\\), '', 'utf8'\\);\n    \\}\n  \\} else \\{\n    throw new Error\\(`No inline template found in \\$\\{tsPath\\}`\\);\n  \\}\n\n  fs\\.writeFileSync\\(absTsPath, text, 'utf8'\\);\n  console\\.log\\(`Updated \\$\\{tsPath\\}`\\);\n\\}\nNODE$/": {
